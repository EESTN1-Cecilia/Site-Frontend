# Dirección del backend: la carpeta backend/ de este mismo repo (npm --prefix
# backend start). Sin esto, el sitio la busca en http://localhost:3000/api, que
# es donde arranca el backend por defecto.
#
# Para usarlo, copiar este archivo como .env.local y ajustar la dirección:
#   cp .env.example .env.local
VITE_API_URL=http://localhost:3000/api
