# Copiar como .env y completar. .env nunca se sube al repositorio.

PORT=3000
# Origen del frontend que puede llamar a la API.
CORS_ORIGIN=http://localhost:5173
# Si el backend corre detrás de un proxy (nginx, Render, Railway…): cuántos saltos confiar.
# Sin esto, detrás de un proxy todos los pedidos parecen venir de la misma IP.
TRUST_PROXY=

# Obligatoria: 32 caracteres aleatorios o más. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Límite de subida en bytes (5 MB por defecto).
MAX_FILE_SIZE=5242880

# Google Drive (service account).
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
DRIVE_EMATP_ID=
DRIVE_JEFE_AREA_ID=

# Sólo para el seed (node src/scripts/seed.js). Obligatorias, 8 caracteres o más.
ADMIN_PASSWORD=
SEED_PASSWORD=
